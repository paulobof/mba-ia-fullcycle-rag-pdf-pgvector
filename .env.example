# Provider usado para embeddings e LLM: openai | gemini
PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5.6-luna

# --- Google Gemini ---
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_LLM_MODEL=gemini-2.5-flash-lite

# --- Postgres + pgVector ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=desafio_rag

# --- Documento a ser ingerido ---
PDF_PATH=document.pdf
